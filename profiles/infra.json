{
  "version": 0,
  "subject": { "agent": "category", "label": "infra" },
  "fs": {
    "home": "rw",
    "rw": ["$PWD", "/nix/var/nix/daemon-socket"],
    "ro": ["/var/log/journal", "/run/log/journal", "/etc/machine-id"],
    "deny": [
      "~/.ssh",
      "~/.gnupg",
      "~/.aws",
      "~/.azure",
      "~/.config/sops",
      "~/.config/age",
      "~/.config/gh",
      "~/.config/op",
      "~/.config/gcloud",
      "~/.password-store",
      "~/.netrc",
      "~/.bash_history",
      "~/.zsh_history",
      "~/.python_history"
    ],
    "derive": ["/srv/share/projects/**"]
  },
  "net": { "mode": "host" },
  "env": {
    "pass": [
      "ANTHROPIC_API_KEY",
      "OPENAI_API_KEY",
      "GEMINI_API_KEY",
      "NIX_REMOTE"
    ]
  },
  "escalation": {
    "auto": [{ "fs.ro": "/srv/share/projects/**", "scope": "session" }],
    "refuse": [
      "~/.ssh/**",
      "~/.gnupg/**",
      "~/.aws/**",
      "~/.azure/**",
      "~/.config/sops/**",
      "~/.config/age/**",
      "~/.config/gh/**",
      "~/.config/op/**",
      "~/.config/gcloud/**",
      "~/.password-store/**",
      "~/.netrc",
      "~/.bash_history",
      "~/.zsh_history",
      "~/.python_history"
    ]
  }
}
