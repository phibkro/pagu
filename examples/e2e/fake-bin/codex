#!/usr/bin/env -S deno run --allow-read --allow-write --allow-env --allow-net
// Test harness for the packaged gate lifecycle. The filename deliberately
// exercises the Codex resume adapter's `codex resume SESSION_ID` argv shape.
import { fileRequest } from "../../../src/request/channel.ts";

const target = Deno.env.get("PAGU_E2E_TARGET");
const marker = Deno.env.get("PAGU_E2E_MARKER");
if (!target || !marker) throw new Error("missing e2e paths");

try {
  const content = await Deno.readTextFile(`${target}/granted.txt`);
  await Deno.writeTextFile(marker, content);
} catch (error) {
  if (!(error instanceof Deno.errors.NotFound) &&
    !(error instanceof Deno.errors.PermissionDenied)) throw error;
  await fileRequest({
    need: "read the packaged Slice 5 fixture",
    justification: "prove request, operator decision, relaunch, and resume",
    suggested_rule: { "fs.ro": target },
  });
}
