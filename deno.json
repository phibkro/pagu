{
  "name": "@phibkro/pagu",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./grant-v0.schema.json": "./schemas/grant-v0.schema.json"
  },
  "tasks": {
    "test": "deno test --allow-run --allow-read --allow-write --allow-env --allow-net",
    "check": "deno check src",
    "lint": "deno lint src scripts",
    "fmt": "deno fmt src scripts profiles deno.json README.md",
    "check:docs": "deno run --allow-read scripts/check-docs.ts",
    "check:layers": "deno run --allow-read=src scripts/check-layers.ts",
    "ci": "deno fmt src scripts profiles deno.json README.md && deno lint src scripts && deno check src && deno run --allow-read=src scripts/check-layers.ts && deno task check:docs && deno task test"
  },
  "fmt": { "lineWidth": 80 },
  "lint": { "rules": { "tags": ["recommended"] } },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "fast-check": "npm:fast-check@^3"
  }
}
