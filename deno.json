{
  "name": "@phibkro/pagu",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./grant-v0.schema.json": "./schemas/grant-v0.schema.json",
    "./profile-grant-v0.schema.json": "./schemas/profile-grant-v0.schema.json"
  },
  "tasks": {
    "test": "deno test --allow-run --allow-read --allow-write --allow-env --allow-net",
    "journey:mock": "deno run -A scripts/mock-gate-journey.ts",
    "journey:box": "deno run -A scripts/box-command-journey.ts",
    "check": "deno check src integrations",
    "lint": "deno lint src scripts integrations",
    "fmt": "deno fmt src scripts integrations profiles deno.json README.md",
    "check:docs": "deno run --allow-read scripts/check-docs.ts",
    "check:layers": "deno run --allow-read=src scripts/check-layers.ts",
    "ci": "deno fmt src scripts integrations profiles deno.json README.md && deno lint src scripts integrations && deno check src integrations && deno run --allow-read=src scripts/check-layers.ts && deno task check:docs && deno task test"
  },
  "fmt": {
    "lineWidth": 80
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "fast-check": "npm:fast-check@^3",
    "@std/cli": "jsr:@std/cli@^1.0.32"
  },
  "vendor": true
}
