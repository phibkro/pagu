{
  "tasks": {
    "test": "deno test --allow-run --allow-read --allow-write --allow-net --allow-env",
    "check": "deno check src",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "ci": "deno fmt && deno lint && deno check src && deno task test",
    "install": "deno install --global --force --config deno.json --allow-run --allow-read --allow-write --allow-env -n pagu ./src/frontends/cli.ts"
  },
  "fmt": { "lineWidth": 80 },
  "lint": { "rules": { "tags": ["recommended"] } },
  "imports": {
    "@agentclientprotocol/sdk": "npm:@agentclientprotocol/sdk@^0.22",
    "@cliffy/command": "jsr:@cliffy/command@^1.1.0",
    "@cliffy/command/completions": "jsr:@cliffy/command@^1.1.0/completions",
    "@cliffy/keypress": "jsr:@cliffy/keypress@^1.1.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225",
    "@std/front-matter/yaml": "jsr:@std/front-matter@^1/yaml",
    "@std/path": "jsr:@std/path@^1",
    "@std/streams": "jsr:@std/streams@^1",
    "fast-check": "npm:fast-check@^3"
  }
}
