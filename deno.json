{
  "tasks": {
    "test": "deno test",
    "check": "deno check src",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "fmt": { "lineWidth": 80 },
  "lint": { "rules": { "tags": ["recommended"] } },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  }
}
