#!/usr/bin/env bash
# pagu pre-commit gate: format-check, lint, typecheck, tests.
# Enable once per clone:  git config core.hooksPath .githooks
# Skips gracefully if deno isn't on PATH so it never blocks a commit on a
# machine without the toolchain (CI, if added, is the backstop).
set -euo pipefail

if ! command -v deno >/dev/null 2>&1; then
  echo "pre-commit: deno not on PATH — skipping checks." >&2
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

# The gate is defined once as `deno task ci` (fmt-check + lint + check + test)
# in deno.json, so the hook and a manual run can't drift apart.
echo "pre-commit: deno task ci"
deno task ci
echo "pre-commit: all green ✓"
